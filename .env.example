# Copy to .env locally; never commit credentials. These names match app.config.Settings.
# Local development example. Production requires HTTPS and the changes noted below.
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_NAME=a_share_risk_agent
DATABASE_USER=your_database_user
DATABASE_PASSWORD=replace_locally

# Authoritative demo/real mode; fake makes no model HTTP requests.
MODEL_PROVIDER=fake
MODEL_ENABLED=true
MODEL_NAME=qwen-plus
MODEL_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# Set only when MODEL_PROVIDER=qwen; keep the key out of source control.
# DASHSCOPE_API_KEY=replace_locally
MODEL_USER_DAILY_LIMIT=20
MODEL_USER_MINUTE_LIMIT=2
MODEL_SITE_DAILY_LIMIT=200
MODEL_MAX_OUTPUT_TOKENS=1024
AGENT_MAX_OUTPUT_TOKENS=4096
RISK_MAX_OUTPUT_TOKENS=1024
RISK_DOCUMENT_OUTPUT_TOKENS=4096
# Whole-document reading saves one continuous batch per request; remaining text is retained.
RISK_DOCUMENT_CHUNK_CHARS=120000
RISK_DOCUMENT_HTTP_TIMEOUT_SECONDS=120
RISK_DOCUMENT_TOTAL_TIMEOUT_SECONDS=180
# Per model call; the complete research still obeys the total deadline below.
MODEL_HTTP_TIMEOUT_SECONDS=30
MODEL_TOTAL_TIMEOUT_SECONDS=120

# API and frontend must use this same origin, including port in local development.
SITE_BASE_URL=http://localhost:8888
AUTH_COOKIE_NAME=session
AUTH_COOKIE_SECURE=false
# Production: SITE_BASE_URL=https://your-domain and AUTH_COOKIE_SECURE=true.
# Cookies are HttpOnly, SameSite=Lax, Path=/; writes need Origin and X-CSRF-Token.
BOOTSTRAP_IP_MINUTE_LIMIT=20
MARKET_USER_MINUTE_LIMIT=120
MARKET_IP_MINUTE_LIMIT=240
CATALOG_IP_MINUTE_LIMIT=120

# Real delivery is deferred. Unconfigured SMTP rejects registration/email requests.
# Configure every required field before external registration; no test-mail fallback.
# SMTP_HOST=smtp.your-provider.example
SMTP_PORT=587
SMTP_TLS=starttls
# SMTP_USERNAME=replace_locally
# SMTP_PASSWORD=replace_locally
# SMTP_FROM=verified-sender@your-domain
SMTP_TIMEOUT_SECONDS=10

# Deployment has no APP_ENV/DEBUG/DATABASE_URL/ANTHROPIC_API_KEY Settings fields.
# Serve /api under the frontend's HTTPS origin; do not add wildcard credentialed CORS.
# Configure Uvicorn proxy trust via --proxy-headers --forwarded-allow-ips=<proxy IP>.
# Never trust arbitrary forwarded IPs; otherwise the public/IP throttle is spoofable.
# Keep PostgreSQL private. Explicitly back up and run schema_upgrade before rollout;
# application startup does not migrate or claim existing private records.

# Optional Fernet key for encrypted administrator API-key updates; see docs/system-settings.md
SETTINGS_ENCRYPTION_KEY=
